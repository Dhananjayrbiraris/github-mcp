# GitHub Personal Access Token (Required for GitHub operations)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Default GitHub Username (Optional)
GITHUB_USERNAME=your_github_username

# List of absolute/relative directories allowed for file operations (comma-separated or JSON list)
ALLOWED_PATHS=["~/projects", "~/workspace", "."]

# Maximum file size in MB for read operations
MAX_FILE_SIZE_MB=10

# Default Transport mode: "stdio" or "sse"
TRANSPORT=stdio
